      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-980, 100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-active",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "Active",
