{
  "name": "WF-01 Marketing Queue Trigger & Intake Gate",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "wf01-trigger-interval",
      "name": "Interval Trigger (Every 10m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 200]
    },
    {
      "parameters": {},
      "id": "wf01-trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 40]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_global_config",
          "mode": "id"
        },
        "filters": {
          "conditions": [
            {
              "field": "config_key",
              "operator": "equals",
              "value": "AUTOMATION_MODE"
            }
          ]
        }
      },
      "id": "wf01-read-global-mode",
      "name": "Read Global AUTOMATION_MODE",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-980, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-mode-active",
              "leftValue": "={{ $json.config_value }}",
              "rightValue": "ACTIVE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf01-if-mode-active",
      "name": "IF AUTOMATION_MODE = ACTIVE",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-760, 120]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Marketing Queue",
          "mode": "name"
        },
        "options": {}
      },
      "id": "wf01-read-marketing-queue",
      "name": "Read Marketing Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-540, 40],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Businesses",
          "mode": "name"
        },
        "options": {}
      },
      "id": "wf01-read-businesses",
      "name": "Read Businesses Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-540, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Join Marketing Queue rows with Businesses and filter by Production Status = 'Planned'\nconst mqItems = $('Read Marketing Queue').all().map((item, idx) => ({ ...item.json, _rowNumber: idx + 2 }));\nconst bizItems = $('Read Businesses Tab').all().map(item => item.json);\n\nconst bizMap = {};\nfor (const b of bizItems) {\n  const key = String(b.Business || '').trim().toLowerCase();\n  if (key) bizMap[key] = b;\n}\n\nconst candidateRows = [];\nfor (const row of mqItems) {\n  const prodStatus = String(row['Production Status'] || '').trim();\n  if (prodStatus !== 'Planned') continue;\n\n  const bizKey = String(row.Business || '').trim().toLowerCase();\n  const bizRecord = bizMap[bizKey] || null;\n  \n  // Check Business Automation Status\n  const bizAutomationStatus = bizRecord ? String(bizRecord['Automation Status'] || 'Active').trim() : 'Active';\n  if (bizAutomationStatus.toLowerCase() === 'paused') {\n    // Gracefully skip - per-business pause\n    continue;\n  }\n\n  candidateRows.push({\n    sheet_row_number: row._rowNumber,\n    business_name: row.Business,\n    business_id: bizRecord ? bizRecord['Business ID'] : '',\n    business_status: bizRecord ? bizRecord.Status : 'Unknown',\n    business_automation_status: bizAutomationStatus,\n    campaign: row.Campaign || '',\n    content_focus: row['Content Focus'] || '',\n    selected_listing: row['Selected Listing'] || '',\n    destination_type: row['Destination Type'] || '',\n    marketing_job: row['Marketing Job'] || '',\n    content_format: row['Content Format'] || '',\n    prompt_template: row['Prompt Template'] || '',\n    creative_direction: row['Creative Direction'] || '',\n    production_status: prodStatus,\n    scheduling_status: row['Scheduling Status'] || 'Not Scheduled'\n  });\n}\n\nreturn candidateRows.map(r => ({ json: r }));"
      },
      "id": "wf01-filter-candidates",
      "name": "Filter Planned & Active Business Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 120]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "wf01-split-jobs",
      "name": "One Job At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-80, 120]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_content_jobs",
          "mode": "id"
        },
        "filters": {
          "conditions": [
            {
              "field": "sheet_row_number",
              "operator": "equals",
              "value": "={{ $json.sheet_row_number }}"
            },
            {
              "field": "idempotency_lock",
              "operator": "equals",
              "value": "LOCKED"
            }
          ]
        }
      },
      "id": "wf01-check-lock",
      "name": "Check Existing Job Lock",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [140, 120],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-has-lock",
              "leftValue": "={{ $json.internal_job_id ? $json.internal_job_id : '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf01-if-locked",
      "name": "IF Already Locked",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [360, 120]
    },
    {
      "parameters": {
        "jsCode": "// Generate unique internal_job_id and prepare registration\nconst job = $('One Job At A Time').first().json;\nconst bizClean = String(job.business_name || 'BIZ').replace(/[^a-zA-Z0-9]/g, '').toUpperCase().slice(0, 8);\nconst rand = Math.random().toString(36).substring(2, 7).toUpperCase();\nconst internalJobId = `JOB_${bizClean}_${Date.now()}_${rand}`;\n\nreturn [{\n  json: {\n    ...job,\n    internal_job_id: internalJobId,\n    idempotency_lock: 'LOCKED',\n    production_status: 'Generating',\n    approval_version: 1,\n    current_drive_location: '04 Generated Drafts',\n    retry_count: 0,\n    sync_status: 'SYNCED',\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf01-generate-job-id",
      "name": "Generate Internal Job ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_content_jobs",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "values": {
            "internal_job_id": "={{ $json.internal_job_id }}",
            "sheet_row_number": "={{ $json.sheet_row_number }}",
            "business_id": "={{ $json.business_id }}",
            "business_name": "={{ $json.business_name }}",
            "marketing_job": "={{ $json.marketing_job }}",
            "content_format": "={{ $json.content_format }}",
            "prompt_template": "={{ $json.prompt_template }}",
            "production_status": "Generating",
            "scheduling_status": "Not Scheduled",
            "approval_version": 1,
            "current_drive_location": "04 Generated Drafts",
            "idempotency_lock": "LOCKED",
            "retry_count": 0,
            "sync_status": "SYNCED",
            "createdAt": "={{ $json.createdAt }}",
            "updatedAt": "={{ $json.updatedAt }}"
          }
        }
      },
      "id": "wf01-register-job",
      "name": "Register Job Lock in Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [820, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Marketing Queue",
          "mode": "name"
        },
        "columnToMatchOn": "Marketing Job",
        "valueToMatchOn": "={{ $json.marketing_job }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Production Status",
              "fieldValue": "Generating"
            }
          ]
        }
      },
      "id": "wf01-update-queue-status",
      "name": "Update MQ Production Status = Generating",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1040, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wf02-validate-marketing-job",
          "mode": "id"
        },
        "options": {}
      },
      "id": "wf01-call-wf02",
      "name": "Call WF-02 Validate Job",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1260, 200]
    },
    {
      "parameters": {},
      "id": "wf01-next-job",
      "name": "Next Planned Job",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1480, 120]
    },
    {
      "parameters": {
        "jsCode": "// Global mode is PAUSED or MAINTENANCE. Log operational notification and stop.\nreturn [{\n  json: {\n    status: 'HALTED',\n    reason: `AUTOMATION_MODE is ${$json.config_value}. New production jobs are blocked.`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf01-log-mode-halt",
      "name": "Halt Production Intake Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 360]
    }
  ],
  "connections": {
    "Interval Trigger (Every 10m)": {
      "main": [[{ "node": "Read Global AUTOMATION_MODE", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Read Global AUTOMATION_MODE", "type": "main", "index": 0 }]]
    },
    "Read Global AUTOMATION_MODE": {
      "main": [[{ "node": "IF AUTOMATION_MODE = ACTIVE", "type": "main", "index": 0 }]]
    },
    "IF AUTOMATION_MODE = ACTIVE": {
      "main": [
        [
          { "node": "Read Marketing Queue", "type": "main", "index": 0 },
          { "node": "Read Businesses Tab", "type": "main", "index": 0 }
        ],
        [{ "node": "Halt Production Intake Gate", "type": "main", "index": 0 }]
      ]
    },
    "Read Marketing Queue": {
      "main": [[{ "node": "Filter Planned & Active Business Intake", "type": "main", "index": 0 }]]
    },
    "Read Businesses Tab": {
      "main": [[{ "node": "Filter Planned & Active Business Intake", "type": "main", "index": 0 }]]
    },
    "Filter Planned & Active Business Intake": {
      "main": [[{ "node": "One Job At A Time", "type": "main", "index": 0 }]]
    },
    "One Job At A Time": {
      "main": [
        [],
        [{ "node": "Check Existing Job Lock", "type": "main", "index": 0 }]
      ]
    },
    "Check Existing Job Lock": {
      "main": [[{ "node": "IF Already Locked", "type": "main", "index": 0 }]]
    },
    "IF Already Locked": {
      "main": [
        [{ "node": "Next Planned Job", "type": "main", "index": 0 }],
        [{ "node": "Generate Internal Job ID", "type": "main", "index": 0 }]
      ]
    },
    "Generate Internal Job ID": {
      "main": [[{ "node": "Register Job Lock in Data Table", "type": "main", "index": 0 }]]
    },
    "Register Job Lock in Data Table": {
      "main": [[{ "node": "Update MQ Production Status = Generating", "type": "main", "index": 0 }]]
    },
    "Update MQ Production Status = Generating": {
      "main": [[{ "node": "Call WF-02 Validate Job", "type": "main", "index": 0 }]]
    },
    "Call WF-02 Validate Job": {
      "main": [[{ "node": "Next Planned Job", "type": "main", "index": 0 }]]
    },
    "Next Planned Job": {
      "main": [[{ "node": "One Job At A Time", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
