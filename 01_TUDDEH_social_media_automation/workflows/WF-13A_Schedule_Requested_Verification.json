{
  "name": "WF-13A Schedule Requested to Verified Scheduled State",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "wf13a-trigger-interval",
      "name": "Poll Interval (Every 10m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 100]
    },
    {
      "parameters": {},
      "id": "wf13a-trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, -60]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Marketing Queue",
          "mode": "name"
        },
        "options": {}
      },
      "id": "wf13a-read-queue",
      "name": "Read Marketing Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-980, 40],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter rows where human requested scheduling\nconst rows = $input.all().map(i => i.json);\nconst requestedRows = rows.filter(r => {\n  const s = String(r['Scheduling Status'] || '').trim();\n  const dt = String(r['Scheduled Date / Time'] || '').trim();\n  return s === 'Schedule Requested' && dt.length > 0;\n});\n\nreturn requestedRows.map(r => ({ json: r }));"
      },
      "id": "wf13a-filter-schedule-requested",
      "name": "Filter Schedule Requested Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 40]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "wf13a-split-rows",
      "name": "One Requested Job At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-520, 40]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_content_jobs",
          "mode": "id"
        },
        "filters": {
          "conditions": [
            {
              "field": "marketing_job",
              "operator": "equals",
              "value": "={{ $json['Marketing Job'] }}"
            }
          ]
        }
      },
      "id": "wf13a-get-job",
      "name": "Lookup Job Record in tuddeh_content_jobs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-300, 40],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Verify internal job is Ready to Schedule and prepare Drive move to 02 Scheduled\nconst row = $('One Requested Job At A Time').first().json;\nconst job = $input.item?.json || {};\n\nlet canSchedule = true;\nlet reason = '';\n\nif (!job.internal_job_id) {\n  canSchedule = false;\n  reason = 'Internal job not found in Data Table.';\n} else if (job.scheduling_status === 'Scheduled' || job.scheduling_status === 'Published') {\n  canSchedule = false;\n  reason = `Job already in advanced status: ${job.scheduling_status}`;\n} else if (!job.drive_approved_folder_id) {\n  canSchedule = false;\n  reason = 'Missing drive_approved_folder_id for approved package.';\n}\n\nconst masterScheduledParentId = $env.DRIVE_05_02_SCHEDULED_FOLDER_ID || '05_02_SCHEDULED_MASTER_ID';\nconst oldFolderParentId = $env.DRIVE_05_01_READY_TO_SCHEDULE_FOLDER_ID || '05_01_READY_TO_SCHEDULE_MASTER_ID';\n\nreturn [{\n  json: {\n    ...row,\n    internal_job_id: job.internal_job_id,\n    drive_approved_folder_id: job.drive_approved_folder_id,\n    can_schedule: canSchedule,\n    reason: reason,\n    destination_parent_id: masterScheduledParentId,\n    source_parent_id: oldFolderParentId\n  }\n}];"
      },
      "id": "wf13a-verify-eligibility",
      "name": "Verify Eligibility for Scheduled State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 40]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-can-sched",
              "leftValue": "={{ $json.can_schedule }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf13a-if-eligible",
      "name": "IF Eligible to Move",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [140, 40]
    },
    {
      "parameters": {
        "resource": "fileOrFolder",
        "operation": "move",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.drive_approved_folder_id }}",
          "mode": "id"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $json.destination_parent_id }}",
          "mode": "id"
        }
      },
      "id": "wf13a-move-folder-to-scheduled",
      "name": "Move Package to 02 Scheduled",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [360, -40],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "googleDriveOAuth2Api",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Verify move outcome\nconst prep = $('Verify Eligibility for Scheduled State').first().json;\nconst movedFolder = $input.item.json;\n\nconst isMoved = movedFolder.id === prep.drive_approved_folder_id;\n\nreturn [{\n  json: {\n    ...prep,\n    move_verified: isMoved\n  }\n}];"
      },
      "id": "wf13a-verify-move",
      "name": "Verify Move Succeeded",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, -40]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-move-ok",
              "leftValue": "={{ $json.move_verified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf13a-if-move-ok",
      "name": "IF Move Verified",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, -40]
    },
    {
      "parameters": {
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_content_jobs",
          "mode": "id"
        },
        "matchColumns": ["internal_job_id"],
        "columns": {
          "mappingMode": "defineBelow",
          "values": {
            "internal_job_id": "={{ $json.internal_job_id }}",
            "current_drive_location": "02 Scheduled",
            "scheduling_status": "Scheduled",
            "updatedAt": "={{ $now.toISOString() }}"
          }
        }
      },
      "id": "wf13a-update-job-datatable-scheduled",
      "name": "Update Data Table = Scheduled",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [1020, -100]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Marketing Queue",
          "mode": "name"
        },
        "columnToMatchOn": "Marketing Job",
        "valueToMatchOn": "={{ $json['Marketing Job'] }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Scheduling Status",
              "fieldValue": "Scheduled"
            }
          ]
        }
      },
      "id": "wf13a-update-sheet-scheduled",
      "name": "Update Sheet: Scheduling Status = Scheduled",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1240, -100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_error_log",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "values": {
            "error_id": "=ERR_MOVE_SCHED_{{$now.toMillis()}}",
            "timestamp": "={{$now.toISOString()}}",
            "workflow": "WF-13A",
            "internal_job_id": "={{$json.internal_job_id}}",
            "business": "={{$json.Business}}",
            "node": "Move Package to 02 Scheduled",
            "error_type": "SYSTEM",
            "error_message": "Drive move to 02 Scheduled failed verification. Leaving Scheduling Status = Schedule Requested.",
            "resolved": false
          }
        }
      },
      "id": "wf13a-log-move-fail",
      "name": "Log Move Failure to Error Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [1020, 40]
    },
    {
      "parameters": {},
      "id": "wf13a-next-item",
      "name": "Next Item in Batch",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1460, 40]
    }
  ],
  "connections": {
