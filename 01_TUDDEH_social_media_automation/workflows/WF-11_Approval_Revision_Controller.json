{
  "name": "WF-11 Approval Revision Rejection Controller",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "tuddeh-approval",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "id": "wf11-webhook-trigger",
      "name": "Webhook: tuddeh-approval",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-980, 100],
      "webhookId": "tuddeh-approval"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "tuddeh_content_jobs",
          "mode": "id"
        },
        "filters": {
          "conditions": [
            {
              "field": "internal_job_id",
              "operator": "equals",
              "value": "={{ $json.query.jobId }}"
            }
          ]
        }
      },
      "id": "wf11-lookup-job",
      "name": "Lookup Job in tuddeh_content_jobs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-740, 100],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Authenticate approval action, token, version, and reviewer identity\nconst webhookData = $('Webhook: tuddeh-approval').first().json;\nconst query = webhookData.query || {};\nconst job = $input.item?.json || {};\n\nconst action = String(query.action || '').toLowerCase();\nconst incomingToken = String(query.token || '');\nconst incomingVersion = Number(query.version || 0);\n\nconst storedToken = String(job.approval_token || '');\nconst storedVersion = Number(job.approval_version || 1);\n\n// Identity and token validation\nlet authSuccess = true;\nlet authFailureReason = '';\n\nif (!job.internal_job_id) {\n  authSuccess = false;\n  authFailureReason = 'Internal Job record not found in system.';\n} else if (!storedToken || incomingToken !== storedToken) {\n  authSuccess = false;\n  authFailureReason = 'Invalid or expired single-use approval token.';\n} else if (incomingVersion !== storedVersion) {\n  authSuccess = false;\n  authFailureReason = `Stale approval link. This action is for revision ${incomingVersion}, but current revision is ${storedVersion}.`;\n} else if (!['approve', 'revise', 'reject'].includes(action)) {\n  authSuccess = false;\n  authFailureReason = `Unsupported action '${action}'. Must be approve, revise, or reject.`;\n}\n\nreturn [{\n  json: {\n    ...job,\n    requested_action: action,\n    auth_success: authSuccess,\n    auth_failure_reason: authFailureReason,\n    revision_notes: query.notes || 'Revision requested via approval portal'\n  }\n}];"
      },
      "id": "wf11-auth-decision",
      "name": "Validate Token & Version Guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-auth-success",
              "leftValue": "={{ $json.auth_success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf11-if-authorized",
      "name": "IF Action Authorized",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-280, 100]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.requested_action }}",
                    "rightValue": "approve",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.requested_action }}",
                    "rightValue": "revise",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "wf11-switch-action",
      "name": "Route Action: Approve / Revise / Reject",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-60, 40]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_TRACKER_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Marketing Queue",
          "mode": "name"
        },
        "columnToMatchOn": "Marketing Job",
        "valueToMatchOn": "={{ $json.marketing_job }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Production Status",
              "fieldValue": "Approved"
            }
          ]
        }
      },
