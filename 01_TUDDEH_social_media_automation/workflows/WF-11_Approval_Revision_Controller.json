        "responseBody": "<!DOCTYPE html><html><body style='font-family:sans-serif;background:#0d1117;color:#58a6ff;padding:40px;text-align:center;'><h1>✅ Content Approved!</h1><p style='color:#c9d1d9;'>WF-12 is packaging the approved content and moving it to <strong>01 Ready to Schedule</strong>.</p></body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
