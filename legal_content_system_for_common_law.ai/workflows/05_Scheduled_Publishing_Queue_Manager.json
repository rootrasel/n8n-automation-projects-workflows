{
  "name": "WF-05 Scheduled Publishing Queue & Buffer Manager",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "wf05-cron-9am",
      "name": "Daily 9:00 AM Queue Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 200]
    },
    {
      "parameters": {},
      "id": "wf05-manual-trigger",
      "name": "Manual Queue Check Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 40]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_SPREADSHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Publishing_Queue",
          "mode": "name"
        },
        "options": {
          "returnAllMatches": true
        }
      },
      "id": "wf05-read-publishing-queue",
      "name": "Read Publishing Queue From Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-960, 120],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googlesheets-commonlaw-creds",
          "name": "Google Sheets OAuth CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.WORDPRESS_BASE_URL}}/wp-json/wp/v2/posts?status=publish&per_page=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "wf05-fetch-live-wp-posts",
      "name": "Check Latest Live Posts on WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 120],
      "credentials": {
        "httpBasicAuth": {
          "id": "wordpress-app-password-creds",
          "name": "WordPress Application Password CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Reconcile queue status with live WordPress posts\nconst queueItems = $items('Read Publishing Queue From Sheet').map(i => i.json);\nconst liveWpPosts = $items('Check Latest Live Posts on WordPress').map(i => i.json);\n\n// Find posts in queue that are now live on WP but have pending social distribution\nconst readyForSocial = [];\n\nfor (const q of queueItems) {\n  if (q.social_status === 'PENDING') {\n    const liveMatch = liveWpPosts.find(p => String(p.id) === String(q.wp_post_id) || p.slug === q.slug);\n    if (liveMatch && liveMatch.status === 'publish') {\n      readyForSocial.push({\n        postId: liveMatch.id,\n        title: liveMatch.title?.rendered || q.article_title,\n        url: liveMatch.link || q.article_url,\n        excerpt: q.excerpt || '',\n        featuredImageUrl: q.featured_image_url || '',\n        queueId: q.queue_id\n      });\n    }\n  }\n}\n\n// Check queue buffer depth (number of queued or drafted items)\nconst pendingBufferCount = queueItems.filter(q => q.wp_status === 'future' || q.wp_status === 'draft').length;\n\nreturn [{\n  json: {\n    readyForSocial: readyForSocial,\n    pendingBufferCount: pendingBufferCount,\n    bufferHealthy: pendingBufferCount >= 3,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf05-reconcile-queue",
      "name": "Analyze Queue & Social Readiness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-social-ready",
              "leftValue": "={{ $json.readyForSocial.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf05-if-social-needed",
      "name": "IF Posts Awaiting Social Posting",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-240, 120]
    },
    {
      "parameters": {
        "jsCode": "// Unroll ready-for-social items for individual dispatch\nconst items = $json.readyForSocial || [];\nreturn items.map(post => ({ json: post }));"
      },
      "id": "wf05-unroll-social-items",
      "name": "Unroll Posts for Social Dispatch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 40]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wf06-social-media-distribution",
          "mode": "id"
        },
        "options": {}
      },
      "id": "wf05-trigger-social-flow",
      "name": "Trigger WF-06 Social Media Distribution",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [240, 40]
    }
  ],
  "connections": {
    "Daily 9:00 AM Queue Cron": {
      "main": [[{ "node": "Read Publishing Queue From Sheet", "type": "main", "index": 0 }]]
    },
    "Manual Queue Check Trigger": {
      "main": [[{ "node": "Read Publishing Queue From Sheet", "type": "main", "index": 0 }]]
    },
    "Read Publishing Queue From Sheet": {
      "main": [[{ "node": "Check Latest Live Posts on WordPress", "type": "main", "index": 0 }]]
    },
    "Check Latest Live Posts on WordPress": {
      "main": [[{ "node": "Analyze Queue & Social Readiness", "type": "main", "index": 0 }]]
    },
    "Analyze Queue & Social Readiness": {
      "main": [[{ "node": "IF Posts Awaiting Social Posting", "type": "main", "index": 0 }]]
    },
    "IF Posts Awaiting Social Posting": {
      "main": [
        [{ "node": "Unroll Posts for Social Dispatch", "type": "main", "index": 0 }],
        []
      ]
    },
    "Unroll Posts for Social Dispatch": {
      "main": [[{ "node": "Trigger WF-06 Social Media Distribution", "type": "main", "index": 0 }]]
    }
  }
}
