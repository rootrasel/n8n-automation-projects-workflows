        [
          {
            "node": "Execution Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execution Successful?": {
      "main": [
        [
          {
            "node": "Update Pipeline Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Capture Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capture Error Details": {
      "main": [
        [
          {
