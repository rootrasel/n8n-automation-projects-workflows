{
  "name": "WF-06 Multi-Channel Social Syndication Engine",
  "nodes": [
    {
      "parameters": {},
      "id": "wf06-manual-trigger",
      "name": "Sub-workflow Intake Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 200]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.7
        },
        "prompt": "=You are a senior social media director for common-law.ai, an authoritative legal portal.\n\nGenerate customized social media posts for the following newly published article:\n- Title: \"{{ $json.title }}\"\n- URL: \"{{ $json.url }}\"\n- Excerpt: \"{{ $json.excerpt }}\"\n- Jurisdiction / State: \"{{ $json.targetState || 'General' }}\"\n- Practice Area: \"{{ $json.practiceArea || 'Law' }}\"\n\nProduce specialized copy for each platform following these rules:\n1. linkedin_post: Authoritative, professional, 3-4 bullet takeaways, relevant hashtags (#LegalTips #CommonLaw #Lawyers), includes the article link.\n2. x_post: Punchy hook, under 250 characters, strong CTA, includes the article link.\n3. facebook_post: Engaging conversational summary, inviting questions/comments, includes the article link.\n4. bluesky_post: Crisp, informative insight, under 280 characters, includes the article link.\n5. threads_post: Modern, relatable legal breakdown, under 300 characters, includes the article link.\n\nReturn ONLY a valid JSON object:\n{\n  \"linkedin_post\": \"...\",\n  \"x_post\": \"...\",\n  \"facebook_post\": \"...\",\n  \"bluesky_post\": \"...\",\n  \"threads_post\": \"...\"\n}"
      },
      "id": "wf06-openai-format-social",
      "name": "AI Format Platform Copy",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [-960, 200],
      "credentials": {
        "openAiApi": {
          "id": "openai-commonlaw-creds",
          "name": "OpenAI CommonLaw API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI-generated social copy and pass along original article metadata\nconst raw = $json.message?.content || $json.text || '';\nlet socialCopy = {};\n\ntry {\n  const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n  socialCopy = JSON.parse(cleaned);\n} catch (e) {\n  const original = $('Sub-workflow Intake Trigger').item.json;\n  socialCopy = {\n    linkedin_post: `New legal guide published: ${original.title}. Read the complete analysis at ${original.url}`,\n    x_post: `Important legal update: ${original.title}. Check it out: ${original.url}`,\n    facebook_post: `Have questions about this legal issue? Read our latest breakdown: ${original.title} ${original.url}`,\n    bluesky_post: `Legal briefing: ${original.title} ${original.url}`,\n    threads_post: `Latest on common-law.ai: ${original.title} ${original.url}`\n  };\n}\n\nconst article = $('Sub-workflow Intake Trigger').item.json;\n\nreturn [{\n  json: {\n    ...article,\n    socialCopy: socialCopy\n  }\n}];"
      },
      "id": "wf06-parse-social-payload",
      "name": "Assemble Platform Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-720, 200]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v19.0/{{$env.FACEBOOK_PAGE_ID}}/feed",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.socialCopy.facebook_post }}\",\n  \"link\": \"{{ $json.url }}\"\n}",
        "options": {}
      },
      "id": "wf06-post-facebook",
      "name": "Publish to Facebook Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, -100],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "facebook-page-token-creds",
          "name": "Facebook Graph API Token CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"author\": \"urn:li:organization:{{$env.LINKEDIN_ORG_ID}}\",\n  \"lifecycleState\": \"PUBLISHED\",\n  \"specificContent\": {\n    \"com.linkedin.ugc.ShareContent\": {\n      \"shareCommentary\": {\n        \"text\": \"{{ $json.socialCopy.linkedin_post }}\"\n      },\n      \"shareMediaCategory\": \"ARTICLE\",\n      \"media\": [\n        {\n          \"status\": \"READY\",\n          \"description\": {\n            \"text\": \"{{ $json.excerpt }}\"\n          },\n          \"originalUrl\": \"{{ $json.url }}\",\n          \"title\": {\n            \"text\": \"{{ $json.title }}\"\n          }\n        }\n      ]\n    }\n  },\n  \"visibility\": {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n}",
        "options": {}
      },
      "id": "wf06-post-linkedin",
      "name": "Publish to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, 50],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "linkedin-oauth-bearer-creds",
          "name": "LinkedIn OAuth Bearer CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.twitter.com/2/tweets",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.socialCopy.x_post }}\"\n}",
        "options": {}
      },
      "id": "wf06-post-x",
      "name": "Publish to X (Twitter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, 200],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "twitter-bearer-auth-creds",
          "name": "Twitter API v2 Bearer CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "https://bsky.social/xrpc/com.atproto.repo.createRecord",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"repo\": \"{{$env.BLUESKY_HANDLE}}\",\n  \"collection\": \"app.bsky.feed.post\",\n  \"record\": {\n    \"$type\": \"app.bsky.feed.post\",\n    \"text\": \"{{ $json.socialCopy.bluesky_post }}\",\n    \"createdAt\": \"{{ new Date().toISOString() }}\",\n    \"embed\": {\n      \"$type\": \"app.bsky.embed.external\",\n      \"external\": {\n        \"uri\": \"{{ $json.url }}\",\n        \"title\": \"{{ $json.title }}\",\n        \"description\": \"{{ $json.excerpt }}\"\n      }\n    }\n  }\n}",
        "options": {}
      },
      "id": "wf06-post-bluesky",
      "name": "Publish to Bluesky",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, 350],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "bluesky-jwt-creds",
          "name": "Bluesky Access JWT CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://graph.threads.net/v1.0/{{$env.THREADS_USER_ID}}/threads",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"media_type\": \"TEXT\",\n  \"text\": \"{{ $json.socialCopy.threads_post }}\"\n}",
        "options": {}
      },
      "id": "wf06-post-threads",
      "name": "Publish to Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, 500],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "threads-token-creds",
          "name": "Threads Graph Token CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Collate posting results from all platforms\nconst fbResult = $items('Publish to Facebook Page')[0]?.json || { status: 'SKIPPED_OR_FAILED' };\nconst liResult = $items('Publish to LinkedIn')[0]?.json || { status: 'SKIPPED_OR_FAILED' };\nconst xResult = $items('Publish to X (Twitter)')[0]?.json || { status: 'SKIPPED_OR_FAILED' };\nconst bskyResult = $items('Publish to Bluesky')[0]?.json || { status: 'SKIPPED_OR_FAILED' };\nconst threadsResult = $items('Publish to Threads')[0]?.json || { status: 'SKIPPED_OR_FAILED' };\n\nconst article = $('Assemble Platform Payloads').item.json;\n\nreturn [{\n  json: {\n    postId: article.postId,\n    articleUrl: article.url,\n    platforms: {\n      facebook: fbResult.id ? 'SUCCESS' : 'FAILED',\n      linkedin: liResult.id ? 'SUCCESS' : 'FAILED',\n      x: xResult.data?.id ? 'SUCCESS' : 'FAILED',\n      bluesky: bskyResult.uri ? 'SUCCESS' : 'FAILED',\n      threads: threadsResult.id ? 'SUCCESS' : 'FAILED'\n    },\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf06-collate-results",
      "name": "Collate Multi-Channel Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_SPREADSHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Publishing_Queue",
          "mode": "name"
        },
        "matchingColumn": "wp_post_id",
        "matchingValue": "={{ $json.postId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "social_status": "DISTRIBUTED"
          }
        },
        "options": {}
      },
      "id": "wf06-update-queue-sheet",
      "name": "Update Publishing_Queue Social Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [80, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googlesheets-commonlaw-creds",
          "name": "Google Sheets OAuth CommonLaw"
        }
      }
    }
  ],
