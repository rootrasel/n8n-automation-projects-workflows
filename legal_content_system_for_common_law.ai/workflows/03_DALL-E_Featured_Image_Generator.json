{
  "name": "WF-03 AI Featured Image Generator (DALL-E 1600x900 & WP Media)",
  "nodes": [
    {
      "parameters": {},
      "id": "wf03-manual-trigger",
      "name": "Sub-workflow Intake Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 200]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/images/generations",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"dall-e-3\",\n  \"prompt\": \"{{ $json.imagePrompt }}\",\n  \"n\": 1,\n  \"size\": \"1792x1024\",\n  \"quality\": \"standard\",\n  \"response_format\": \"url\"\n}",
        "options": {}
      },
      "id": "wf03-call-dalle3",
      "name": "Generate 16:9 Image via DALL-E 3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-960, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai-bearer-token-creds",
          "name": "OpenAI Bearer Auth CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.data[0].url }}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "wf03-download-image-binary",
      "name": "Download DALL-E Image Binary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 200]
    },
    {
      "parameters": {
        "url": "={{$env.WORDPRESS_BASE_URL}}/wp-json/wp/v2/media",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Disposition",
              "value": "=attachment; filename=\"{{ $('Sub-workflow Intake Trigger').item.json.slug }}-featured.png\""
            },
            {
              "name": "Content-Type",
              "value": "image/png"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "wf03-upload-wp-media",
      "name": "Upload to WordPress Media Library",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-480, 200],
      "credentials": {
        "httpBasicAuth": {
          "id": "wordpress-app-password-creds",
          "name": "WordPress Application Password CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "url": "={{$env.WORDPRESS_BASE_URL}}/wp-json/wp/v2/media/{{ $json.id }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alt_text\": \"{{ $('Sub-workflow Intake Trigger').item.json.imageAltText }}\",\n  \"caption\": \"{{ $('Sub-workflow Intake Trigger').item.json.title }}\",\n  \"description\": \"Featured image for {{ $('Sub-workflow Intake Trigger').item.json.title }} on common-law.ai\"\n}",
        "options": {}
      },
      "id": "wf03-update-media-metadata",
      "name": "Update Image Alt Text & Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 200],
      "credentials": {
        "httpBasicAuth": {
          "id": "wordpress-app-password-creds",
          "name": "WordPress Application Password CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge article package with newly uploaded featured media ID\nconst originalArticle = $('Sub-workflow Intake Trigger').item.json;\nconst mediaRecord = $items('Upload to WordPress Media Library')[0]?.json || {};\n\nreturn [{\n  json: {\n    ...originalArticle,\n    featured_media_id: mediaRecord.id || null,\n    featured_image_url: mediaRecord.source_url || mediaRecord.guid?.rendered || null,\n    image_upload_status: mediaRecord.id ? 'SUCCESS' : 'FAILED'\n  }\n}];"
      },
      "id": "wf03-merge-media-data",
      "name": "Merge Media ID into Article Package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wf04-wordpress-publisher",
          "mode": "id"
        },
        "options": {}
      },
      "id": "wf03-call-wp-publisher",
      "name": "Trigger Next: WF-04 WordPress Publisher",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [240, 200]
    }
  ],
  "connections": {
    "Sub-workflow Intake Trigger": {
      "main": [[{ "node": "Generate 16:9 Image via DALL-E 3", "type": "main", "index": 0 }]]
    },
    "Generate 16:9 Image via DALL-E 3": {
      "main": [[{ "node": "Download DALL-E Image Binary", "type": "main", "index": 0 }]]
    },
    "Download DALL-E Image Binary": {
      "main": [[{ "node": "Upload to WordPress Media Library", "type": "main", "index": 0 }]]
    },
    "Upload to WordPress Media Library": {
      "main": [[{ "node": "Update Image Alt Text & Caption", "type": "main", "index": 0 }]]
    },
    "Update Image Alt Text & Caption": {
      "main": [[{ "node": "Merge Media ID into Article Package", "type": "main", "index": 0 }]]
    },
    "Merge Media ID into Article Package": {
      "main": [[{ "node": "Trigger Next: WF-04 WordPress Publisher", "type": "main", "index": 0 }]]
    }
  }
}
