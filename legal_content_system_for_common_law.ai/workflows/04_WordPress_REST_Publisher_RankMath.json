{
  "name": "WF-04 WordPress REST Publisher & Rank Math SEO Sync",
  "nodes": [
    {
      "parameters": {},
      "id": "wf04-manual-trigger",
      "name": "Sub-workflow Intake Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 200]
    },
    {
      "parameters": {
        "jsCode": "// Prepare WordPress REST payload with Rank Math SEO custom meta\nconst input = $items('Sub-workflow Intake Trigger')[0].json;\n\n// Target status can be 'publish', 'future', or 'draft' (configured via environment)\nconst targetStatus = $env.WORDPRESS_DEFAULT_POST_STATUS || 'publish';\n\nconst payload = {\n  title: input.title,\n  content: input.contentHtml,\n  status: targetStatus,\n  slug: input.slug,\n  excerpt: input.excerpt,\n  featured_media: input.featured_media_id || 0,\n  author: Number($env.WORDPRESS_AUTHOR_ID) || 1,\n  comment_status: 'closed',\n  ping_status: 'closed',\n  meta: {\n    rank_math_title: input.seoTitle || input.title,\n    rank_math_description: input.metaDescription || input.excerpt,\n    rank_math_focus_keyword: input.primaryKeyword || input.targetState || 'legal guide',\n    rank_math_robots: ['index', 'follow']\n  }\n};\n\nreturn [{\n  json: {\n    ...input,\n    wpPayload: payload,\n    targetStatus: targetStatus\n  }\n}];"
      },
      "id": "wf04-prep-wp-payload",
      "name": "Format WP & Rank Math Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 200]
    },
    {
      "parameters": {
        "url": "={{$env.WORDPRESS_BASE_URL}}/wp-json/wp/v2/posts",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.wpPayload) }}",
        "options": {}
      },
      "id": "wf04-create-wp-post",
      "name": "Create Post via WordPress REST API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 200],
      "credentials": {
        "httpBasicAuth": {
          "id": "wordpress-app-password-creds",
          "name": "WordPress Application Password CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_SPREADSHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Topic_Bank",
          "mode": "name"
        },
        "matchingColumn": "topic_id",
        "matchingValue": "={{ $('Format WP & Rank Math Payload').item.json.topicId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "PUBLISHED",
            "notes": "=Published to WordPress. Post ID: {{ $json.id }} URL: {{ $json.link }}"
          }
        },
        "options": {}
      },
      "id": "wf04-update-topic-status",
      "name": "Update Topic_Bank Status in Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-480, 100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googlesheets-commonlaw-creds",
          "name": "Google Sheets OAuth CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{$env.GOOGLE_SHEETS_SPREADSHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Publishing_Queue",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "queue_id": "=QUEUE-{{ $json.id }}",
            "topic_id": "={{ $('Format WP & Rank Math Payload').item.json.topicId }}",
            "wp_post_id": "={{ $json.id }}",
            "article_title": "={{ $json.title.rendered }}",
            "slug": "={{ $json.slug }}",
            "scheduled_publish_time": "={{ $json.date }}",
            "wp_status": "={{ $json.status }}",
            "social_status": "PENDING",
            "article_url": "={{ $json.link }}",
            "featured_image_url": "={{ $('Format WP & Rank Math Payload').item.json.featured_image_url || '' }}"
          }
        },
        "options": {}
      },
      "id": "wf04-append-publishing-queue",
      "name": "Record in Publishing_Queue Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-480, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googlesheets-commonlaw-creds",
          "name": "Google Sheets OAuth CommonLaw"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Prepare package for social syndication\nconst wpPost = $items('Create Post via WordPress REST API')[0]?.json || {};\nconst articleContext = $('Format WP & Rank Math Payload').item.json;\n\nreturn [{\n  json: {\n    postId: wpPost.id,\n    title: wpPost.title?.rendered || articleContext.title,\n    url: wpPost.link || `https://common-law.ai/${wpPost.slug}/`,\n    excerpt: articleContext.excerpt,\n    featuredImageUrl: articleContext.featured_image_url,\n    targetState: articleContext.targetState,\n    practiceArea: articleContext.practiceArea,\n    publishedStatus: wpPost.status\n  }\n}];"
      },
      "id": "wf04-prep-social-dispatch",
      "name": "Prepare Social Syndication Package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-published",
              "leftValue": "={{ $json.publishedStatus }}",
              "rightValue": "publish",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf04-if-live-published",
      "name": "IF Post is Live (Not Future/Draft)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "wf06-social-media-distribution",
          "mode": "id"
        },
        "options": {}
      },
      "id": "wf04-call-social-distribution",
      "name": "Trigger Next: WF-06 Social Media Distribution",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [240, 100]
    }
  ],
  "connections": {
    "Sub-workflow Intake Trigger": {
      "main": [[{ "node": "Format WP & Rank Math Payload", "type": "main", "index": 0 }]]
    },
    "Format WP & Rank Math Payload": {
      "main": [[{ "node": "Create Post via WordPress REST API", "type": "main", "index": 0 }]]
    },
    "Create Post via WordPress REST API": {
      "main": [
        [
          { "node": "Update Topic_Bank Status in Sheets", "type": "main", "index": 0 },
          { "node": "Record in Publishing_Queue Sheet", "type": "main", "index": 0 },
          { "node": "Prepare Social Syndication Package", "type": "main", "index": 0 }
        ]
      ]
    },
    "Prepare Social Syndication Package": {
      "main": [[{ "node": "IF Post is Live (Not Future/Draft)", "type": "main", "index": 0 }]]
    },
    "IF Post is Live (Not Future/Draft)": {
      "main": [
        [{ "node": "Trigger Next: WF-06 Social Media Distribution", "type": "main", "index": 0 }],
        []
      ]
    }
  }
}
