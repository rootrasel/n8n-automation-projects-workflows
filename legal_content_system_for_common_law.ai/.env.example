# ==============================================================================
# Common-Law.ai Automation System — Environment Variables (.env)
# ==============================================================================

# WordPress REST API
WORDPRESS_BASE_URL=https://common-law.ai
WORDPRESS_DEFAULT_POST_STATUS=draft
WORDPRESS_AUTHOR_ID=1

# Google Sheets Master Database
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here

# Inter-Workflow Webhooks (Internal n8n URLs or Public Webhooks)
WF2_WEBHOOK_URL=http://localhost:5678/webhook/wf2-gap-report
WF6_WEBHOOK_URL=http://localhost:5678/webhook/wf6-published-article

# Search & Research APIs
SERPER_API_KEY=your_serper_api_key_here
COURTLISTENER_API_TOKEN=your_courtlistener_api_token_here

# Notifications & Alerts
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your/alert/webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Social Media Channels (for WF6 Multi-Channel Publishing)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
LINKEDIN_ORG_ID=your_linkedin_company_id
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token
TWITTER_BEARER_TOKEN=your_twitter_api_v2_bearer_token
BLUESKY_HANDLE=common-law.bsky.social
BLUESKY_APP_PASSWORD=your_bluesky_app_password
THREADS_USER_ID=your_threads_account_id
THREADS_ACCESS_TOKEN=your_threads_access_token
